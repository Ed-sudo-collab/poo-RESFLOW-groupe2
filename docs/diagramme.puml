@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam dpi 150

skinparam interface {
  BackgroundColor #E8F0FE
  BorderColor #1F4E79
  FontColor #1F4E79
}

skinparam abstract {
  BackgroundColor #FFF8E8
  BorderColor #1F4E79
}

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
  HeaderBackgroundColor #1F4E79
  FontColor #1A1A1A
}

interface Reservable {
  + estDisponible() : boolean
  + reserver(numeroReservation : int, utilisateur : Utilisateur, creneau : Creneau) : boolean
  + liberer() : void
  + dureeMaxReservation() : int
  + getReservationActive() : Reservation
  + afficher() : void
}

abstract class Ressource {
  - code : String
  - nom : String
  - disponible : boolean
  - reservationActive : Reservation
  --
  + typeRessource() : String
  + estDisponible() : boolean
  + reserver(...) : boolean
  + liberer() : void
  + afficher() : void
  + {abstract} dureeMaxReservation() : int
}

class Salle {
  - capacite : int
  --
  + dureeMaxReservation() : int
}

class MaterielMobile {
  - numeroSerie : String
  - categorie : String
  --
  + dureeMaxReservation() : int
}

class PosteTravail {
  - code : String
  - zone : String
  - disponible : boolean
  - reservationActive : Reservation
  --
  + dureeMaxReservation() : int
}

class Utilisateur {
  - numero : int
  - nom : String
  - email : String
  --
  + afficher() : void
}

class Creneau {
  - numero : int
  - jour : String
  - heureDebut : int
  - heureFin : int
  --
  + getDuree() : int
  + afficher() : void
}

class Reservation {
  - numero : int
  --
  + afficher() : void
}

class CatalogueReservable {
  - elements : ArrayList<Reservable>
  --
  + ajouter(element : Reservable) : void
  + nombreDisponibles() : int
  + afficherDisponibles() : void
}

class HistoriqueReservations {
  - reservations : ArrayList<Reservation>
  --
  + enregistrer(reservation : Reservation) : void
  + afficher() : void
  + nombre() : int
}

CatalogueReservable o-- "0..*" Reservable : elements
HistoriqueReservations o-- "0..*" Reservation : reservations

Reservable <|.. Ressource
Reservable <|.. PosteTravail
Ressource <|-- Salle
Ressource <|-- MaterielMobile

Ressource "1" o-- "0..1" Reservation : reservationActive
PosteTravail "1" o-- "0..1" Reservation : reservationActive
Reservation "0..*" --> "1" Reservable
Reservation "0..*" --> "1" Utilisateur
Reservation "0..*" --> "1" Creneau

note bottom of PosteTravail
  Exemple Reservable
  sans heriter de Ressource
end note

@enduml
